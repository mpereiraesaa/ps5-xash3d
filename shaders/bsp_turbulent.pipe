[Version]
version = 65

[VsGlsl]
#version 450
layout(location = 0) in vec3 in_position;
layout(location = 1) in vec2 in_base_uv;
layout(location = 2) in vec2 in_light_uv;
layout(set = 0, binding = 0, std140) uniform FrameConstants {
    mat4 mvp;
    vec4 control;
    vec4 debug_values[3];
} frame;
layout(location = 0) out vec2 raw_uv;
layout(location = 1) out vec4 control;
layout(location = 2) out float animation_time;
void main() {
    gl_Position = frame.mvp * vec4(in_position, 1.0);
    raw_uv = in_base_uv;
    control = frame.control + frame.debug_values[0] * 0.0000001;
    animation_time = frame.debug_values[1].x;
}

[VsInfo]
entryPoint = main

[FsGlsl]
#version 450
layout(set = 1, binding = 0) uniform sampler2D base_texture;
layout(set = 1, binding = 1) uniform sampler2D lightmap_texture;
layout(location = 0) in vec2 raw_uv;
layout(location = 1) in vec4 control;
layout(location = 2) in float animation_time;
layout(location = 0) out vec4 color;
void main() {
    const float tau = 6.28318530717958647692;
    vec2 warped_uv;
    warped_uv.x = (raw_uv.x +
        sin((raw_uv.y * 0.125 + animation_time) * tau) * 8.0) / 64.0;
    warped_uv.y = (raw_uv.y +
        sin((raw_uv.x * 0.125 + animation_time) * tau) * 8.0) / 64.0;
    vec4 water = texture(base_texture, warped_uv);
    color = vec4(water.rgb * control.rgb, water.a * control.a);
}

[FsInfo]
entryPoint = main

[ResourceMapping]
userDataNode[0].visibility = 2
userDataNode[0].type = DescriptorTableVaPtr
userDataNode[0].offsetInDwords = 0
userDataNode[0].sizeInDwords = 1
userDataNode[0].next[0].type = DescriptorConstBuffer
userDataNode[0].next[0].offsetInDwords = 0
userDataNode[0].next[0].sizeInDwords = 4
userDataNode[0].next[0].set = 0
userDataNode[0].next[0].binding = 0
userDataNode[1].visibility = 2
userDataNode[1].type = IndirectUserDataVaPtr
userDataNode[1].offsetInDwords = 1
userDataNode[1].sizeInDwords = 1
userDataNode[1].indirectUserDataCount = 1
userDataNode[2].visibility = 64
userDataNode[2].type = DescriptorTableVaPtr
userDataNode[2].offsetInDwords = 0
userDataNode[2].sizeInDwords = 1
userDataNode[2].next[0].type = DescriptorCombinedTexture
userDataNode[2].next[0].offsetInDwords = 0
userDataNode[2].next[0].sizeInDwords = 12
userDataNode[2].next[0].set = 1
userDataNode[2].next[0].binding = 0
userDataNode[2].next[1].type = DescriptorCombinedTexture
userDataNode[2].next[1].offsetInDwords = 12
userDataNode[2].next[1].sizeInDwords = 12
userDataNode[2].next[1].set = 1
userDataNode[2].next[1].binding = 1

[GraphicsPipelineState]
